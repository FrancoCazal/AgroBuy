# LLM provider - copy to .env and fill in your key.
# For OpenAI:
#   LLM_API_URL=https://api.openai.com/v1
#   LLM_MODEL_ID=gpt-4o-mini      (or gpt-4o, gpt-4-turbo, gpt-3.5-turbo, etc.)
# For Anthropic, Ollama, OpenRouter, OpenCode-Go: any OpenAI-compatible endpoint works.
LLM_ENABLED=true
LLM_API_KEY=sk-replace-with-your-openai-api-key
LLM_API_URL=https://api.openai.com/v1
LLM_MODEL_ID=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# ML model path - set to the generated model artifact
# ML_MODEL_PATH=backend/models/corn_rf_v1.0.0_cc1f0282.joblib

# Database (for local dev with docker-compose)
BACKEND_DATABASE_URL=postgresql://agropredict:agropredict@localhost:5432/agropredict
BACKEND_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------
# Docker Compose secrets (only used by docker-compose.yml).
# Generate fresh values for production:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------
BACKEND_ENCRYPTION_ACTIVE_WRAPPING_KEY=wz2tQ0ROVQCJggYX9HOynPmqVLOfe5g2Y4Ll7OOMAvA=
BACKEND_WEBHOOK_SHARED_SECRET=dev_webhook_secret_change_me_local_only_64_chars_minimum_aaaaaaaa
VITE_API_BASE=http://localhost:8000
